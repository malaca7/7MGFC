{
  "manifest_version": 3,
  "name": "7MGFC",
  "version": "1.0.0",
  "description": "Extensão ultra-minimalista para download e gerenciamento local de arquivos e recursos.",
  "action": {
    "default_popup": "index.html",
    "default_title": "7MGFC"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://www.magnific.com/*",
    "https://*.magnific.com/*",
    "https://www.freepik.com/*",
    "https://*.freepik.com/*",
    "https://crsqpssomhkpapqcoftr.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}